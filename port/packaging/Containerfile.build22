# Build environment for releases: Ubuntu 22.04 (glibc 2.35) so the binaries run
# on 22.04 and 24.04 LTS, Debian 12 and 13, and current Fedora/openSUSE.
#
# 22.04 only packages wxWidgets 3.0, so 3.2 is built here from source and linked
# statically - that keeps wx out of the runtime dependencies entirely and leaves
# only GTK, SQLite and glibc, all of which the host provides.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget ca-certificates pkg-config file \
        libgtk-3-dev libsqlite3-dev libssl-dev libexpat1-dev \
        libnotify-dev libsecret-1-dev desktop-file-utils fuse3 \
    && rm -rf /var/lib/apt/lists/*

ARG WX_VERSION=3.2.6
RUN wget -q https://github.com/wxWidgets/wxWidgets/releases/download/v${WX_VERSION}/wxWidgets-${WX_VERSION}.tar.bz2 \
    && tar xf wxWidgets-${WX_VERSION}.tar.bz2 \
    && cd wxWidgets-${WX_VERSION} \
    && ./configure --with-gtk=3 --disable-shared --enable-unicode \
                   --disable-debug --without-opengl --enable-webview=no \
                   --prefix=/opt/wx32 \
    && make -j"$(nproc)" \
    && make install \
    && cd / && rm -rf wxWidgets-${WX_VERSION} wxWidgets-${WX_VERSION}.tar.bz2

ENV PATH=/opt/wx32/bin:$PATH
WORKDIR /src
