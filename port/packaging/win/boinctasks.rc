#include <windows.h>

/* RT_MANIFEST: gives the process themed Common Controls v6 and per-monitor DPI.
   Without it Windows renders the pre-XP grey widgets. */
1 24 "boinctasks.manifest"

/* wxWidgets loads the lowest-numbered icon as the application icon */
aaaa ICON "boinctasks.ico"

/* The version arrives from CMake (BT_VERSION), so a release bump happens in one
   place. These defaults only apply to a bare windres run outside the build. */
#ifndef BT_VERSION_STR
#define BT_VERSION_STR "0.9.4b"
#endif
#ifndef BT_VERSION_COMMA
#define BT_VERSION_COMMA 0,9,4,2
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    BT_VERSION_COMMA
PRODUCTVERSION BT_VERSION_COMMA
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Skillz"
            VALUE "FileDescription",  "BoincTasks++ - manage BOINC across many computers"
            VALUE "FileVersion",      BT_VERSION_STR
            VALUE "InternalName",     "BoincTasksPP"
            VALUE "LegalCopyright",   "GPLv3. Based on BoincTasks by eFMer (Fred)."
            VALUE "OriginalFilename", "BoincTasksPP.exe"
            VALUE "ProductName",      "BoincTasks++"
            VALUE "ProductVersion",   BT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
